# Local server only. Leave blank until an approved key is configured.
# Never put a real key in this example or browser code.
# serve.mjs and live-bay-* checks load the private .env automatically.
# Explicit process environment variables take precedence over .env.
OPENAI_API_KEY=
VOLTGUARD_INGEST_TOKEN=
VOLTGUARD_PORT=4173
# Bay AI: deployment switch. Keep false during stub-only development.
VOLTGUARD_AI_ENABLED=false
VOLTGUARD_AI_BASE_URL=
VOLTGUARD_AI_MODEL=
VOLTGUARD_AI_API_KEY=
